'number' + 3 + 3
'number' + 3 => 'number3' (конкатенація рядка і числа)
'number3' + 3 => 'number33' (знову конкатенація)
Результат: 'number33'

null + 3
null перетворюється на 0 при додаванні
0 + 3 => 3
Результат: 3

5 && "qwerty"
Оператор && повертає останнє істинне значення
5 — істинне => повертається "qwerty"
Результат: "qwerty"

+'40' + +'2' + "hillel"
+'40' => 40 (унарний плюс перетворює рядок у число)
+'2' => 2
40 + 2 => 42
42 + 'hillel' => '42hillel' (конкатенація)
Результат: '42hillel'

'10' - 5 === 6
'10' - 5 => 5 (рядок перетворюється в число)
5 === 6 => false
Результат: false

true + false
true => 1, false => 0
1 + 0 => 1
Результат: 1

'4px' - 3
'4px' не можна перетворити на число => NaN
NaN - 3 => NaN
Результат: NaN

'4' - 3
'4' => 4 - приведення до числа 4
4 - 3 => 1
Результат: 1

'6' + 3 ** 0
3 ** 0 => 1 піднесення до степеня - будь-яке число в нульовому степені це 1
'6' + 1 => '61' (конкатенація)
Результат: '61'

12 / '6'
'6' => 6 - приведення до числа 6
12 / 6 => 2
Результат: 2

'10' + (5 === 6)
5 === 6 => false - 5 строго не дорівнює 6
'10' + false => '10false' - (конкатенація)
Результат: '10false'

null == ''
null == '' => false (особливість операторів порівняння: null тільки рівне undefined)
Результат: false

3 ** (9 / 3)
9 / 3 => 3 - ділення
3 ** 3 => 27 - приведення в ступінь 
Результат: 27

!!'false' == !!'true'
'false' — непорожній рядок =>  тому це true
'true' — також => true
!!'false' => true і !!'true' => true 
true == true => true
Результат: true

0 || '0' && 1 
Оператор && має вищий пріоритет, ніж ||, тому спочатку виконується
'0' && 1 
'0' — це непорожній рядок => істинне
1 — теж істинне
Оператор || повертає перше істинне значення:
0 — хибне
1 — істинне
0 || 1
Результат: 1


(+null == false) < 1;
+null => 0
0 == false => true
true < 1 => true
Результат: true

false && true || true
(false || true) => true  повертає перше істинне значення або останнє, якщо всі хибні
false && true => false - оператор повертає перше хибне значення, або останнє, якщо всі істинн
Результат: false - перше значення false, тому далі іти не треба 

(+null == false) < 1 ** 5;
+null => 0 - Унарний плюс + приводить null до числа
0 == false => true - Оператор == — нестроге порівняння, тому типи приводяться
1 ** 5 - Піднесення до степеня = 1
true < 1 
true дорівнює одиниці і тому 
1 < 1 = false
Результат: афдиу








