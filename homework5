var services = {
  "стрижка": "60 грн",
  "гоління": "80 грн",
  "Миття голови": "100 грн",

   // Метод для обчислення загальної вартості послуг
  price: function () {
    let total = 0;
    for (let key in this) {
      if (typeof this[key] === "string" && this[key].includes("грн")) {
        total += parseFloat(this[key]);
      }
    }
    return total + " грн";
  },

  // Метод для визначення мінімальної вартості
  minPrice: function () {
    let prices = [];

    for (let key in this) {
      if (typeof this[key] === "string" && this[key].includes("грн")) {
        prices.push(parseFloat(this[key]));
      }
    }

    let min = Math.min(...prices);
    return min + " грн";
  },

  // Метод для визначення максимальної вартості
  maxPrice: function () {
    let prices = [];

    for (let key in this) {
      if (typeof this[key] === "string" && this[key].includes("грн")) {
        prices.push(parseFloat(this[key]));
      }
    }

    let max = Math.max(...prices);
    return max + " грн";
  }
};

// Додавання нової послуги
services['Розбити скло'] = "200 грн";

// Використання методів
console.log("Загальна вартість:", services.price());     // Загальна вартість: 440 грн
console.log("Мінімальна ціна:", services.minPrice());     // Мінімальна ціна: 60 грн
console.log("Максимальна ціна:", services.maxPrice());    // Максимальна ціна: 200 грн
